{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "signal4d.prediction_meta.1.0",
  "type": "object",
  "required": ["schema_version", "clip_id", "frame_ids", "coordinate_convention", "length_unit", "status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "clip_id": {"type": "string"},
    "frame_ids": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
    "coordinate_convention": {"const": "opencv_x_right_y_down_z_forward"},
    "length_unit": {"const": "meter"},
    "status": {"enum": ["success", "success_with_recovery", "abstained_high_risk", "failed_preprocess", "failed_optimization", "invalid_output"]}
  }
}

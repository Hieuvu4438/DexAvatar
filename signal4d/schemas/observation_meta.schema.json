{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "signal4d.observation_meta.1.0",
  "type": "object",
  "required": ["schema_version", "clip_id", "sources", "camera_convention", "length_unit"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "clip_id": {"type": "string"},
    "sources": {"type": "array", "minItems": 1},
    "camera_convention": {"const": "opencv_x_right_y_down_z_forward"},
    "length_unit": {"const": "meter"}
  }
}
